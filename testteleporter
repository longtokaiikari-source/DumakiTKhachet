-- ====== LOGIC ======
local points = {}
local selectedPoint = nil

local function getRootPart()
    local char = player.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function getCurrentPosition()
    local root = getRootPart()
    return root and root.Position or nil
end

-- Cập nhật tọa độ real-time
coroutine.wrap(function()
    while true do
        task.wait(0.2)
        local pos = getCurrentPosition()
        if pos then
            coordBox.Text = string.format("📍 X: %.2f | Y: %.2f | Z: %.2f", pos.X, pos.Y, pos.Z)
        else
            coordBox.Text = "⏳ Chờ nhân vật..."
        end
    end
end)()

-- Làm mới danh sách
local function refreshList()
    -- Xóa các button cũ (chỉ xóa TextButton)
    for _, child in ipairs(listFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    local names = {}
    for name, _ in pairs(points) do
        table.insert(names, name)
    end
    countLabel.Text = "Điểm: " .. #names
    
    -- Hiển thị từng điểm
    for _, name in ipairs(names) do
        local pos = points[name]
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -10, 0, 25)
        btn.Text = name .. " - " .. string.format("%.2f, %.2f, %.2f", pos.X, pos.Y, pos.Z)
        btn.BackgroundColor3 = Color3.fromRGB(60,60,70)
        btn.TextColor3 = Color3.new(1,1,1)
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.TextScaled = true
        btn.BorderSizePixel = 1
        btn.BorderColor3 = Color3.fromRGB(100,100,100)
        btn.Parent = listFrame
        
        btn.MouseButton1Click:Connect(function()
            selectedPoint = name
            -- Đổi màu các button
            for _, b in ipairs(listFrame:GetChildren()) do
                if b:IsA("TextButton") then
                    b.BackgroundColor3 = Color3.fromRGB(60,60,70)
                end
            end
            btn.BackgroundColor3 = Color3.fromRGB(0, 120, 0)
        end)
    end
    
    -- Cập nhật kích thước canvas
    listFrame.CanvasSize = UDim2.new(0, 0, 0, #names * 30 + 10)
end

-- Sự kiện toggle
local function toggleUI()
    mainFrame.Visible = not mainFrame.Visible
    toggleBtn.Text = mainFrame.Visible and "-" or "+"
    if mainFrame.Visible then
        refreshList()
    end
end

toggleBtn.MouseButton1Click:Connect(toggleUI)

-- Lưu điểm
saveBtn.MouseButton1Click:Connect(function()
    local name = nameBox.Text
    if name == "" then
        coordBox.Text = "⚠️ Nhập tên!"
        return
    end
    local pos = getCurrentPosition()
    if not pos then
        coordBox.Text = "⚠️ Không có nhân vật!"
        return
    end
    if points[name] then
        coordBox.Text = "⚠️ Tên đã tồn tại!"
        return
    end
    points[name] = pos
    refreshList()
    nameBox.Text = ""
    coordBox.Text = "✅ Đã lưu '" .. name .. "'"
end)

-- Xóa điểm chọn
delBtn.MouseButton1Click:Connect(function()
    if selectedPoint and points[selectedPoint] then
        points[selectedPoint] = nil
        selectedPoint = nil
        refreshList()
        coordBox.Text = "🗑️ Đã xóa điểm."
    else
        coordBox.Text = "⚠️ Chưa chọn điểm!"
    end
end)

-- Teleport
tpBtn.MouseButton1Click:Connect(function()
    if selectedPoint and points[selectedPoint] then
        local pos = points[selectedPoint]
        local root = getRootPart()
        if root then
            root.CFrame = CFrame.new(pos)
            coordBox.Text = "🚀 Teleport đến '" .. selectedPoint .. "'"
