-- Làm cho toggleBtn kéo được (có xử lý click)
local function makeDraggableWithClick(button, onClick)
    local dragActive = false
    local startMouse = nil
    local startPos = nil
    local moved = false
    
    button.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragActive = true
            startMouse = input.Position
            startPos = button.Position
            moved = false
        end
    end)
    
    button.InputChanged:Connect(function(input)
        if dragActive and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            local delta = input.Position - startMouse
            if delta.Magnitude > 5 then moved = true end
            local newX = startPos.X.Offset + delta.X
            local newY = startPos.Y.Offset + delta.Y
            button.Position = UDim2.new(0, newX, 0, newY)
        end
    end)
    
    button.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            if dragActive and not moved and onClick then
                onClick()
            end
            dragActive = false
        end
    end)
end

-- Hàm toggle
local function toggleGUI()
    mainFrame.Visible = not mainFrame.Visible
    if mainFrame.Visible then
        toggleBtn.Text = "-"
    else
        toggleBtn.Text = "+"
    end
end

makeDraggableWithClick(toggleBtn, toggleGUI)

