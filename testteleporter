-- ====== SCRIPT DÙNG RAYFIELD UI LIBRARY ======
-- LocalScript (đặt trong StarterPlayerScripts hoặc StarterGui)

-- 1. TẢI RAYFIELD
local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

-- 2. TẠO CỬA SỔ CHÍNH
local Window = Rayfield:CreateWindow({
    Name = "Teleporter ProTK",
    LoadingTitle = "Đang tải...",
    LoadingSubtitle = "by TK",
    ConfigurationSaving = {
        Enabled = false
    },
    Discord = {
        Enabled = false
    },
    KeySystem = false
})

-- 3. TẠO TAB CHÍNH
local MainTab = Window:CreateTab("Teleport", 4483362458) -- icon

-- 4. BIẾN LƯU TRỮ
local points = {}          -- { [name] = Vector3 }
local selectedPoint = nil  -- tên điểm đang chọn

-- Hàm lấy nhân vật và HumanoidRootPart
local function getRootPart()
    local char = game.Players.LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

-- Hàm lấy tọa độ hiện tại (dạng Vector3)
local function getCurrentPosition()
    local root = getRootPart()
    return root and root.Position or nil
end

-- 5. HIỂN THỊ TỌA ĐỘ REAL-TIME (dùng Label cập nhật mỗi 0.2s)
local coordLabel = MainTab:CreateLabel("Đang lấy tọa độ...")

coroutine.wrap(function()
    while true do
        task.wait(0.2)
        local pos = getCurrentPosition()
        if pos then
            coordLabel:Set(string.format("📍 X: %.2f | Y: %.2f | Z: %.2f", pos.X, pos.Y, pos.Z))
        else
            coordLabel:Set("⏳ Chờ nhân vật...")
        end
    end
end)()

-- 6. KHU VỰC NHẬP TÊN VÀ LƯU ĐIỂM (dùng Section + Input + Button)
local saveSection = MainTab:CreateSection("📌 Lưu điểm mới")

local nameInput = MainTab:CreateInput({
    Name = "Tên điểm",
    PlaceholderText = "Nhập tên (vd: Nhà, Cổng, ...)",
    RemoveTextAfterFocusLost = false,
    Callback = function() end
})

MainTab:CreateButton({
    Name = "✅ Lưu điểm hiện tại",
    Callback = function()
        local name = nameInput.CurrentValue
        if name == "" or name == nil then
            Rayfield:Notify({
                Title = "Lỗi",
                Content = "Vui lòng nhập tên điểm!",
                Duration = 3
            })
            return
        end
        local pos = getCurrentPosition()
        if not pos then
            Rayfield:Notify({
                Title = "Lỗi",
                Content = "Không tìm thấy nhân vật!",
                Duration = 3
            })
            return
        end
        if points[name] then
            Rayfield:Notify({
                Title = "Trùng tên",
                Content = "Điểm '" .. name .. "' đã tồn tại!",
                Duration = 3
            })
            return
        end
        points[name] = pos
        refreshPointList()
        Rayfield:Notify({
            Title = "Thành công",
            Content = "Đã lưu điểm '" .. name .. "'",
            Duration = 2
        })
        nameInput:Set("") -- xóa ô input sau khi lưu
    end
})

-- 7. DANH SÁCH ĐIỂM (Dropdown để chọn + Button Teleport & Xóa)
local listSection = MainTab:CreateSection("📋 Danh sách điểm")

-- Dropdown để chọn điểm (sẽ cập nhật động)
local pointDropdown = MainTab:CreateDropdown({
    Name = "Chọn điểm",
    Options = {},
    CurrentOption = "",
    Callback = function(option)
        selectedPoint = option
    end
})

-- Hàm làm mới danh sách điểm (cập nhật Dropdown)
local function refreshPointList()
    local names = {}
    for name, _ in pairs(points) do
        table.insert(names, name)
    end
    -- Cập nhật options cho dropdown
    pointDropdown:Set(names)
    -- Nếu danh sách rỗng, reset selected
    if #names == 0 then
        selectedPoint = nil
        pointDropdown:Set({""}) -- đặt option rỗng
    elseif selectedPoint and not points[selectedPoint] then
        selectedPoint = nil
    end
end

-- Nút Teleport đến điểm đã chọn
MainTab:CreateButton({
    Name = "🚀 Teleport đến điểm chọn",
    Callback = function()
        if not selectedPoint or not points[selectedPoint] then
            Rayfield:Notify({
                Title = "Lỗi",
                Content = "Vui lòng chọn một điểm trong danh sách!",
                Duration = 3
            })
            return
        end
        local pos = points[selectedPoint]
        local root = getRootPart()
        if not root then
            Rayfield:Notify({
                Title = "Lỗi",
                Content = "Không tìm thấy nhân vật!",
                Duration = 3
            })
            return
        end
        root.CFrame = CFrame.new(pos)
        Rayfield:Notify({
            Title = "Teleport thành công",
            Content = "Đã đến '" .. selectedPoint .. "'",
            Duration = 2
        })
    end
})

-- Nút Xóa điểm đã chọn
MainTab:CreateButton({
    Name = "🗑️ Xóa điểm chọn",
    Callback = function()
        if not selectedPoint or not points[selectedPoint] then
            Rayfield:Notify({
                Title = "Lỗi",
                Content = "Vui lòng chọn một điểm để xóa!",
                Duration = 3
            })
            return
        end
        points[selectedPoint] = nil
        selectedPoint = nil
        refreshPointList()
        Rayfield:Notify({
            Title = "Đã xóa",
            Content = "Điểm đã được xóa khỏi danh sách.",
            Duration = 2
        })
    end
})

-- 8. NÚT COPY TỌA ĐỘ HIỆN TẠI
local copySection = MainTab:CreateSection("📋 Tiện ích khác")

MainTab:CreateButton({
    Name = "📄 Copy tọa độ hiện tại",
    Callback = function()
        local pos = getCurrentPosition()
        if not pos then
            Rayfield:Notify({
                Title = "Lỗi",
                Content = "Không có tọa độ để copy!",
                Duration = 3
            })
            return
        end
        local str = string.format("X: %.2f | Y: %.2f | Z: %.2f", pos.X, pos.Y, pos.Z)
        if setclipboard then
            setclipboard(str)
            Rayfield:Notify({
                Title = "Đã copy",
                Content = str,
                Duration = 3
            })
        else
            Rayfield:Notify({
                Title = "Lỗi",
                Content = "Trình duyệt không hỗ trợ setclipboard.",
                Duration = 3
            })
        end
    end
})

-- Nút Clear All (xóa toàn bộ điểm)
MainTab:CreateButton({
    Name = "🧹 Xóa tất cả điểm",
    Callback = function()
        points = {}
        selectedPoint = nil
        refreshPointList()
        Rayfield:Notify({
            Title = "Đã xóa",
            Content = "Tất cả điểm đã bị xóa.",
            Duration = 2
        })
    end
})

-- 9. KHỞI TẠO DANH SÁCH LẦN ĐẦU
refreshPointList()

-- 10. THÔNG BÁO KHỞI ĐỘNG
Rayfield:Notify({
    Title = "✅ Teleporter Pro",
    Content = "Đã sẵn sàng! Dùng phím K để mở/đóng UI (mặc định).",
    Duration = 5
})

print("Teleporter Prosuccessfully!")
