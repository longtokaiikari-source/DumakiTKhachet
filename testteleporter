-- ====== LOGIC CHÍNH ======
local points = {}
local selectedPoint = nil

local function getCharacterPosition()
    local char = player.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    return root and root.Position or nil
end

local function updateCoordDisplay()
    local pos = getCharacterPosition()
    if pos then
        coordBox.Text = string.format("Coordinates: X: %.2f | Y: %.2f | Z: %.2f", pos.X, pos.Y, pos.Z)
    else
        coordBox.Text = "Coordinates: Waiting for character..."
    end
end

local function refreshList()
    for _, child in ipairs(listFrame:GetChildren()) do
        if child:IsA("TextButton") then child:Destroy() end
    end
    for name, pos in pairs(points) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -10, 0, 25)
        btn.Text = name .. " - " .. string.format("%.2f, %.2f, %.2f", pos.X, pos.Y, pos.Z)
        btn.BackgroundColor3 = Color3.fromRGB(60,60,70)
        btn.TextColor3 = Color3.new(1,1,1)
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.TextScaled = true
        btn.BorderSizePixel = 1
        btn.BorderColor3 = Color3.fromRGB(100,100,100)
        btn.Parent = listFrame
        btn.MouseButton1Click:Connect(function()
            selectedPoint = name
            for _, b in ipairs(listFrame:GetChildren()) do
                if b:IsA("TextButton") then b.BackgroundColor3 = Color3.fromRGB(60,60,70) end
            end
            btn.BackgroundColor3 = Color3.fromRGB(0, 120, 0)
        end)
    end
    local count = 0
    for _ in pairs(points) do count = count + 1 end
    listFrame.CanvasSize = UDim2.new(0, 0, 0, count * 30 + 10)
end

-- Cập nhật tọa độ liên tục
coroutine.wrap(function()
    while wait(0.2) do updateCoordDisplay() end
end)()

-- Sự kiện nút toggle (chỉ click, không kéo)
toggleBtn.MouseButton1Click:Connect(function()
    mainFrame.Visible = not mainFrame.Visible
    toggleBtn.Text = mainFrame.Visible and "-" or "+"
    if mainFrame.Visible then
        updateCoordDisplay()
        refreshList()
    end
end)

-- Các nút chức năng
saveBtn.MouseButton1Click:Connect(function()
    local name = nameBox.Text
    if name == "" then coordBox.Text = "Nhập tên!" return end
    local pos = getCharacterPosition()
    if not pos then coordBox.Text = "Không có nhân vật!" return end
    if points[name] then coordBox.Text = "Tên đã tồn tại!" return end
    points[name] = pos
    refreshList()
    nameBox.Text = ""
    coordBox.Text = "Đã lưu: " .. name
end)

delBtn.MouseButton1Click:Connect(function()
    if selectedPoint and points[selectedPoint] then
        points[selectedPoint] = nil
        selectedPoint = nil
        refreshList()
        coordBox.Text = "Đã xóa điểm."
    else
        coordBox.Text = "Chưa chọn điểm!"
    end
end)

tpBtn.MouseButton1Click:Connect(function()
    if selectedPoint and points[selectedPoint] then
        local pos = points[selectedPoint]
        local char = player.Character
        if char then
            local root = char:FindFirstChild("HumanoidRootPart")
            if root then
                root.CFrame = CFrame.new(pos)
                coordBox.Text = "Teleport đến " .. selectedPoint
            else
                coordBox.Text = "Không tìm thấy HumanoidRootPart."
            end
        else
            coordBox.Text = "Nhân vật chưa xuất hiện."
        end
    else
        coordBox.Text = "Chưa chọn điểm!"
    end
end)

copyBtn.MouseButton1Click:Connect(function()
    local pos = getCharacterPosition()
    if pos then
        local str = string.format("X: %.2f | Y: %.2f | Z: %.2f", pos.X, pos.Y, pos.Z)
        if setclipboard then
            setclipboard(str)
            coordBox.Text = "Đã copy: " .. str
        else
            coordBox.Text = "Không hỗ trợ clipboard."
        end
    else
        coordBox.Text = "Không có tọa độ."
    end
end)

clearBtn.MouseButton1Click:Connect(function()
    points = {}
    selectedPoint = nil
    refreshList()
    coordBox.Text = "Đã xóa tất cả."
end)

-- Khởi tạo
refreshList()
updateCoordDisplay()
print("Script run.")
