-- ====== RAYFIELD FIX LỖI SETVALUE & HIỂN THỊ ĐIỂM ======
-- LocalScript - dán toàn bộ

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
    Name = "Teleporter Pro tokai",
    LoadingTitle = "Đang tải...",
    LoadingSubtitle = "by LongTokai",
    ConfigurationSaving = { Enabled = false },
    Discord = { Enabled = false },
    KeySystem = false
})

local MainTab = Window:CreateTab("Teleport", 4483362458)

-- Lưu trữ
local points = {}
local selectedPoint = nil

-- Hàm lấy root
local function getRootPart()
    local char = game.Players.LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function getCurrentPosition()
    local root = getRootPart()
    return root and root.Position or nil
end

-- Label tọa độ
local coordLabel = MainTab:CreateLabel("⏳ Đang lấy tọa độ...")
coroutine.wrap(function()
    while true do
        task.wait(0.2)
        local pos = getCurrentPosition()
        if pos then
            coordLabel:Set(string.format("📍 X: %.2f | Y: %.2f | Z: %.2f", pos.X, pos.Y, pos.Z))
        else
            coordLabel:Set("⏳ Chờ nhân vật...")
        end
    end
end)()

local countLabel = MainTab:CreateLabel("📦 Số điểm: 0")

-- Phần lưu điểm
MainTab:CreateSection("📌 Lưu điểm mới")
local nameInput = MainTab:CreateInput({
    Name = "Tên điểm",
    PlaceholderText = "Nhập tên",
    RemoveTextAfterFocusLost = false,
    Callback = function() end
})

-- Dropdown (tạo sau)
local pointDropdown = nil

-- Hàm refresh (dùng method Set để cập nhật options)
local function refreshPointList()
    local names = {}
    for name, _ in pairs(points) do
        table.insert(names, name)
    end
    countLabel:Set("📦 Số điểm: " .. #names)
    
    print("=== REFRESH ===")
    print("Points:", points)
    print("Names:", table.concat(names, ", "))
    
    if #names == 0 then
        table.insert(names, "(không có điểm)")
    end
    
    if pointDropdown then
        -- Cập nhật danh sách options bằng Set (không dùng SetValue)
        pointDropdown:Set(names)
        -- Chọn item đầu tiên nếu có điểm thực
        if #names > 0 and names[1] ~= "(không có điểm)" then
            pointDropdown:SetOption(names[1]) -- SetOption để chọn
            selectedPoint = names[1]
        else
            pointDropdown:SetOption("(không có điểm)")
            selectedPoint = nil
        end
    end
end

-- Nút lưu
MainTab:CreateButton({
    Name = "✅ Lưu điểm hiện tại",
    Callback = function()
        local name = nameInput.CurrentValue
        if name == "" or name == nil then
            Rayfield:Notify({ Title = "Lỗi", Content = "Nhập tên!", Duration = 3 })
            return
        end
        local pos = getCurrentPosition()
        if not pos then
            Rayfield:Notify({ Title = "Lỗi", Content = "Không có nhân vật!", Duration = 3 })
            return
        end
        if points[name] then
            Rayfield:Notify({ Title = "Trùng tên", Content = "Điểm '"..name.."' đã tồn tại!", Duration = 3 })
            return
        end
        points[name] = pos
        print("Đã lưu:", name, pos)
        refreshPointList()
        nameInput:Set("")
        Rayfield:Notify({ Title = "Thành công", Content = "Đã lưu '"..name.."'", Duration = 2 })
    end
})

-- Danh sách
MainTab:CreateSection("📋 Danh sách điểm")
pointDropdown = MainTab:CreateDropdown({
    Name = "Chọn điểm",
    Options = {"(không có điểm)"},
    CurrentOption = "(không có điểm)",
    Callback = function(option)
        if option ~= "(không có điểm)" then
            selectedPoint = option
            print("Đã chọn:", option)
        else
            selectedPoint = nil
        end
    end
})

-- Teleport
MainTab:CreateButton({
    Name = "🚀 Teleport",
    Callback = function()
        if not selectedPoint or not points[selectedPoint] then
            Rayfield:Notify({ Title = "Lỗi", Content = "Chọn điểm hợp lệ!", Duration = 3 })
            return
        end
        local pos = points[selectedPoint]
        local root = getRootPart()
        if not root then
            Rayfield:Notify({ Title = "Lỗi", Content = "Không có nhân vật!", Duration = 3 })
            return
        end
        root.CFrame = CFrame.new(pos)
        Rayfield:Notify({ Title = "Teleport", Content = "Đã đến '"..selectedPoint.."'", Duration = 2 })
    end
})

-- Xóa
MainTab:CreateButton({
    Name = "🗑️ Xóa",
    Callback = function()
        if not selectedPoint or not points[selectedPoint] then
            Rayfield:Notify({ Title = "Lỗi", Content = "Chọn điểm để xóa!", Duration = 3 })
            return
        end
        points[selectedPoint] = nil
        selectedPoint = nil
        refreshPointList()
        Rayfield:Notify({ Title = "Đã xóa", Content = "Điểm đã xóa.", Duration = 2 })
    end
})

-- Tiện ích
MainTab:CreateSection("📋 Tiện ích")
MainTab:CreateButton({
    Name = "📄 Copy tọa độ",
    Callback = function()
        local pos = getCurrentPosition()
        if not pos then
            Rayfield:Notify({ Title = "Lỗi", Content = "Không có tọa độ!", Duration = 3 })
            return
        end
        local str = string.format("X: %.2f | Y: %.2f | Z: %.2f", pos.X, pos.Y, pos.Z)
        if setclipboard then
            setclipboard(str)
            Rayfield:Notify({ Title = "Copied", Content = str, Duration = 3 })
        else
            Rayfield:Notify({ Title = "Lỗi", Content = "Clipboard không hỗ trợ.", Duration = 3 })
        end
    end
})

MainTab:CreateButton({
    Name = "🧹 Xóa tất cả",
    Callback = function()
        points = {}
        selectedPoint = nil
        refreshPointList()
        Rayfield:Notify({ Title = "Đã xóa hết", Content = "Tất cả điểm đã bị xóa.", Duration = 2 })
    end
})

-- Khởi tạo
refreshPointList()

Rayfield:Notify({
    Title = "✅ Teleporter Pro tokai",
    Content = "Phím K mở/đóng.",
    Duration = 5
})
