-- ====== SCRIPT RAYFIELD FIX LỖI KHÔNG HIỂN THỊ ĐIỂM ĐÃ LƯU ======
-- LocalScript (đặt trong StarterPlayerScripts hoặc StarterGui)
-- Copy toàn bộ và dán vào file .lua

local Rayfield = loadstring(game:HttpGet('https://sirius.menu/rayfield'))()

local Window = Rayfield:CreateWindow({
    Name = "Teleporter Pro tokai",
    LoadingTitle = "Đang tải...",
    LoadingSubtitle = "by LongTokai)",
    ConfigurationSaving = { Enabled = false },
    Discord = { Enabled = false },
    KeySystem = false
})

local MainTab = Window:CreateTab("Teleport", 4483362458)

-- Lưu trữ
local points = {}          -- key = tên, value = Vector3
local selectedPoint = nil

-- Hàm lấy root
local function getRootPart()
    local char = game.Players.LocalPlayer.Character
    if not char then return nil end
    return char:FindFirstChild("HumanoidRootPart")
end

local function getCurrentPosition()
    local root = getRootPart()
    return root and root.Position or nil
end

-- Label hiển thị tọa độ real-time
local coordLabel = MainTab:CreateLabel("⏳ Đang lấy tọa độ...")

coroutine.wrap(function()
    while true do
        task.wait(0.2)
        local pos = getCurrentPosition()
        if pos then
            coordLabel:Set(string.format("📍 X: %.2f | Y: %.2f | Z: %.2f", pos.X, pos.Y, pos.Z))
        else
            coordLabel:Set("⏳ Chờ nhân vật...")
        end
    end
end)()

-- Label hiển thị số điểm đã lưu (để debug)
local countLabel = MainTab:CreateLabel("📦 Số điểm đã lưu: 0")

-- Phần lưu điểm
MainTab:CreateSection("📌 Lưu điểm mới")

local nameInput = MainTab:CreateInput({
    Name = "Tên điểm",
    PlaceholderText = "Nhập tên (vd: Nhà, Cổng...)",
    RemoveTextAfterFocusLost = false,
    Callback = function() end
})

-- Dropdown danh sách điểm (khai báo trước)
local pointDropdown = nil

-- Hàm refresh danh sách (có in debug ra console)
local function refreshPointList()
    local names = {}
    for name, _ in pairs(points) do
        table.insert(names, name)
    end
    -- Cập nhật label số điểm
    countLabel:Set("📦 Số điểm đã lưu: " .. #names)
    
    -- In ra console để kiểm tra
    print("=== REFRESH POINT LIST ===")
    print("Points table:", points)
    print("Names list:", table.concat(names, ", "))
    
    if #names == 0 then
        table.insert(names, "(không có điểm)")
    end
    
    if pointDropdown then
        pointDropdown:Set(names)
        -- Chọn option đầu tiên nếu có điểm thật
        if #names > 0 and names[1] ~= "(không có điểm)" then
            pointDropdown:SetValue(names[1])
            selectedPoint = names[1]
            print("Selected first:", selectedPoint)
        else
            pointDropdown:SetValue("(không có điểm)")
            selectedPoint = nil
        end
    else
        print("WARNING: pointDropdown chưa được khởi tạo!")
    end
end

-- Nút lưu điểm
MainTab:CreateButton({
    Name = "✅ Lưu điểm hiện tại",
    Callback = function()
        local name = nameInput.CurrentValue
        if name == "" or name == nil then
            Rayfield:Notify({ Title = "Lỗi", Content = "Vui lòng nhập tên điểm!", Duration = 3 })
            return
        end
        local pos = getCurrentPosition()
        if not pos then
            Rayfield:Notify({ Title = "Lỗi", Content = "Không tìm thấy nhân vật!", Duration = 3 })
            return
        end
        if points[name] then
            Rayfield:Notify({ Title = "Trùng tên", Content = "Điểm '" .. name .. "' đã tồn tại!", Duration = 3 })
            return
        end
        points[name] = pos
        print("Đã lưu điểm:", name, pos)  -- debug console
        refreshPointList()
        nameInput:Set("")
        Rayfield:Notify({ Title = "Thành công", Content = "Đã lưu điểm '" .. name .. "'", Duration = 2 })
    end
})

-- Phần danh sách
MainTab:CreateSection("📋 Danh sách điểm")

-- Tạo dropdown (gán vào biến pointDropdown)
pointDropdown = MainTab:CreateDropdown({
    Name = "Chọn điểm",
    Options = {"(không có điểm)"},
    CurrentOption = "(không có điểm)",
    Callback = function(option)
        if option ~= "(không có điểm)" then
            selectedPoint = option
            print("Đã chọn:", option)
        else
            selectedPoint = nil
        end
    end
})

-- Nút Teleport
MainTab:CreateButton({
    Name = "🚀 Teleport đến điểm chọn",
    Callback = function()
        if not selectedPoint or not points[selectedPoint] then
            Rayfield:Notify({ Title = "Lỗi", Content = "Vui lòng chọn một điểm hợp lệ!", Duration = 3 })
            return
        end
        local pos = points[selectedPoint]
        local root = getRootPart()
        if not root then
            Rayfield:Notify({ Title = "Lỗi", Content = "Không tìm thấy nhân vật!", Duration = 3 })
            return
        end
        root.CFrame = CFrame.new(pos)
        Rayfield:Notify({ Title = "Teleport thành công", Content = "Đã đến '" .. selectedPoint .. "'", Duration = 2 })
    end
})

-- Nút Xóa điểm
MainTab:CreateButton({
    Name = "🗑️ Xóa điểm chọn",
    Callback = function()
        if not selectedPoint or not points[selectedPoint] then
            Rayfield:Notify({ Title = "Lỗi", Content = "Chọn một điểm để xóa!", Duration = 3 })
            return
        end
        points[selectedPoint] = nil
        selectedPoint = nil
        refreshPointList()
        Rayfield:Notify({ Title = "Đã xóa", Content = "Điểm đã được xóa.", Duration = 2 })
    end
})

-- Phần tiện ích
MainTab:CreateSection("📋 Tiện ích khác")

MainTab:CreateButton({
    Name = "📄 Copy tọa độ hiện tại",
    Callback = function()
        local pos = getCurrentPosition()
        if not pos then
            Rayfield:Notify({ Title = "Lỗi", Content = "Không có tọa độ!", Duration = 3 })
            return
        end
        local str = string.format("X: %.2f | Y: %.2f | Z: %.2f", pos.X, pos.Y, pos.Z)
        if setclipboard then
            setclipboard(str)
            Rayfield:Notify({ Title = "Đã copy", Content = str, Duration = 3 })
        else
            Rayfield:Notify({ Title = "Lỗi", Content = "Không hỗ trợ clipboard.", Duration = 3 })
        end
    end
})

MainTab:CreateButton({
    Name = "🧹 Xóa tất cả điểm",
    Callback = function()
        points = {}
        selectedPoint = nil
        refreshPointList()
        Rayfield:Notify({ Title = "Đã xóa", Content = "Tất cả điểm đã bị xóa.", Duration = 2 })
    end
})

-- Khởi tạo lần đầu
refreshPointList()

-- Thông báo
Rayfield:Notify({
    Title = "✅ Teleporter Pro Tokai",
    Content = "Mở/đóng bằng phím K.",
    Duration = 5
})

print("Script load")
