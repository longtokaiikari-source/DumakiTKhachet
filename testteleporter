local points = {} -- { [name] = Vector3 }
local selectedPoint = nil

-- Hàm cập nhật danh sách hiển thị
local function refreshList()
    -- Xóa các button con cũ (chỉ xóa TextButton)
    for _, child in ipairs(listFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    for name, pos in pairs(points) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -10, 0, 25)
        btn.Text = name .. " - " .. string.format("%.2f, %.2f, %.2f", pos.X, pos.Y, pos.Z)
        btn.BackgroundColor3 = Color3.fromRGB(60,60,70)
        btn.TextColor3 = Color3.new(1,1,1)
        btn.TextXAlignment = Enum.TextXAlignment.Left
        btn.TextScaled = true
        btn.BorderSizePixel = 1
        btn.BorderColor3 = Color3.fromRGB(100,100,100)
        btn.Parent = listFrame
        
        -- Khi click vào tên thì chọn điểm đó
        btn.MouseButton1Click:Connect(function()
            selectedPoint = name
            -- Đổi màu các button
            for _, b in ipairs(listFrame:GetChildren()) do
                if b:IsA("TextButton") then
                    b.BackgroundColor3 = Color3.fromRGB(60,60,70)
                end
            end
            btn.BackgroundColor3 = Color3.fromRGB(0, 120, 0)
        end)
    end
    
    -- Cập nhật canvas size
    local count = #points
    listFrame.CanvasSize = UDim2.new(0, 0, 0, count * 30 + 10)
end

-- Hàm lấy tọa độ nhân vật
local function getCharacterPosition()
    local char = player.Character
    if not char then return nil end
    local root = char:FindFirstChild("HumanoidRootPart")
    if root then
        return root.Position
    end
    return nil
end

-- Cập nhật tọa độ hiển thị (gọi liên tục)
local function updateCoordDisplay()
    local pos = getCharacterPosition()
    if pos then
        coordBox.Text = string.format("Coordinates: X: %.2f | Y: %.2f | Z: %.2f", pos.X, pos.Y, pos.Z)
    else
        coordBox.Text = "Coordinates: Waiting for character..."
    end
end

-- Vòng lặp cập nhật tọa độ (mỗi 0.2s)
coroutine.wrap(function()
    while wait(0.2) do
        updateCoordDisplay()
    end
end)()

