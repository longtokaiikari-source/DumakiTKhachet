-- Đã có makeDraggable cho dragButton, nhưng lưu ý xung đột với sự kiện click mở UI.
-- Kéo và click là hai hành động khác nhau, nhưng nếu kéo mà vẫn kích hoạt click thì gây phiền.
-- Giải pháp: phân biệt bằng khoảng cách di chuyển.
-- Tôi sẽ điều chỉnh lại makeDraggable để trả về biến đã kéo hay chưa.

-- Cải tiến: thêm biến đếm để nếu đã kéo thì không kích hoạt click.
-- Nhưng vì đơn giản, tôi dùng cách: khi nhấn xuống và nhả ra nếu vị trí thay đổi ít hơn 5px thì coi là click.
-- Tôi sẽ viết lại dragButton xử lý riêng:

local isDragging = false
local downPos = nil

dragButton.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        downPos = input.Position
        isDragging = false
    end
end)

dragButton.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
        if downPos and (input.Position - downPos).Magnitude > 8 then
            isDragging = true
        end
    end
end)

-- Gán sự kiện click (thay vì MouseButton1Click trực tiếp)
dragButton.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        if not isDragging and downPos and (input.Position - downPos).Magnitude < 10 then
            -- Đây là click thực sự
            mainFrame.Visible = not mainFrame.Visible
        end
        downPos = nil
    end
end)

