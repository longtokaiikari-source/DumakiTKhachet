local Players = game:GetService("Players")
local RunService = game:GetService("RunService")
local HttpService = game:GetService("HttpService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer
local Camera = workspace.CurrentCamera

local function FindReplicator()
    local RS = rawget(_G, "ReplicatorService")
    if RS and RS.LocalActor then return RS end
    local ok, gc = pcall(function() return getgc(true) end)
    if not ok or not gc then return nil end
    for _, v in pairs(gc) do
        if type(v) == "table" and rawget(v, "Actors") and rawget(v, "LocalActor") then
            RS = v; _G.ReplicatorService = v; return v
        end
    end
    return nil
end

local function GetEnemies()
    if ActorManager and ActorManager.Enemies and #ActorManager.Enemies > 0 then
        return ActorManager.Enemies
    end
    local RS = FindReplicator()
    if not RS or not RS.Actors then return {} end
    local list = {}
    local me = RS.LocalActor
    for _, a in pairs(RS.Actors) do
        if a and a.Alive and a.Character and a ~= me then
            if not a.Owner or a.Owner ~= LocalPlayer then
                list[#list + 1] = a
            end
        end
    end
    return list
end

local function GetMyActor()
    local RS = FindReplicator()
    return RS and RS.LocalActor
end

local MagicBullet = { Enabled = false, TargetPart = "Head", _hooked = false }

function MagicBullet:_getTarget()
    local target, bestDist = nil, math.huge
    local me = GetMyActor()
    local origin = me and me.Position or Camera.CFrame.Position
    for _, a in ipairs(GetEnemies()) do
        local pos = a.Position
        if pos then
            local d = (pos - origin).Magnitude
            if d < bestDist then bestDist = d; target = a end
        end
    end
    return target
end

function MagicBullet:_getTargetPart(actor)
    if not actor or not actor.Character then return nil end
    return actor.Character:FindFirstChild(self.TargetPart)
        or actor.Character:FindFirstChild("Head")
        or actor.Character:FindFirstChild("UpperTorso")
        or actor.Character.PrimaryPart
end

function MagicBullet:HookFirearmController(ctrl)
    if type(ctrl) ~= "table" then return end
    if ctrl._magicBulletHooked then return end

    if ctrl.GetMuzzleCFrame then
        ctrl._origGetMuzzle = ctrl.GetMuzzleCFrame
        ctrl.GetMuzzleCFrame = function(self, ...)
            local cf, a, b = ctrl._origGetMuzzle(self, ...)
            if not MagicBullet.Enabled then return cf, a, b end
            local target = MagicBullet:_getTarget()
            if not target then return cf, a, b end
            local part = MagicBullet:_getTargetPart(target)
            if not part then return cf, a, b end
            local newCF = CFrame.new(cf.Position, part.Position)
            return newCF, a, b
        end
    end

    if ctrl.Discharge then
        ctrl._origDischarge = ctrl.Discharge
        ctrl.Discharge = function(self, ...)
            if MagicBullet.Enabled then
                local target = MagicBullet:_getTarget()
                if target then
                    local part = MagicBullet:_getTargetPart(target)
                    if part then
                        local cf = self:GetMuzzleCFrame()
                        if cf then
                            local newCF = CFrame.new(cf.Position, part.Position)
                            local old = self.GetMuzzleCFrame
                            self.GetMuzzleCFrame = function() return newCF end
                            ctrl._origDischarge(self, ...)
                            self.GetMuzzleCFrame = old
                            return
                        end
                    end
                end
            end
            return ctrl._origDischarge(self, ...)
        end
    end
    ctrl._magicBulletHooked = true
end

function MagicBullet:ScanControllers()
    local RS = FindReplicator()
    if not RS or not RS.Actors then return end
    local ok, gc = pcall(function() return getgc(true) end)
    if not ok or not gc then return end
    for _, v in pairs(gc) do
        if type(v) == "table" and rawget(v, "_firearm") and (rawget(v, "_actor") or rawget(v, "_mag")) then
            local actor = rawget(v, "_actor")
            if actor and actor.IsLocalPlayer then
                self:HookFirearmController(v)
            end
        end
    end
end

function MagicBullet:Start()
    if self._running then return end
    self._running = true
    self.Enabled = true
    self:ScanControllers()
    self._conn = RunService.Heartbeat:Connect(function()
        if tick() - (self._lastScan or 0) > 2 then
            self._lastScan = tick()
            self:ScanControllers()
        end
    end)
    print("[MagicBullet] STARTED")
end

function MagicBullet:Stop()
    self._running = false
    self.Enabled = false
    if self._conn then self._conn:Disconnect(); self._conn = nil end
    print("[MagicBullet] STOPPED")
end

_G.MagicBullet = MagicBullet
getgenv().MagicBullet = MagicBullet

local KillAura = {
    Enabled = false,
    Range = 15,
    Interval = 0.1,
    TargetPart = "Head",
    _last = 0,
    _conn = nil,
}

function KillAura:_getEquippedMelee()
    local RS = FindReplicator()
    local me = RS and RS.LocalActor
    if not me or not me._equipped then return nil end
    local item = me._inventory and me._inventory[me._equipped]
    if not item then return nil end
    if item.Name and (item.Name:find("Melee") or item.Name:find("Knife") or item.Name:find("Axe")) then
        return item
    end
    return item
end

function KillAura:_attack(actor)
    local me = GetMyActor()
    if not me or not actor or not actor.Character then return end
    local targetPart = actor.Character:FindFirstChild(self.TargetPart)
        or actor.Character:FindFirstChild("Head")
        or actor.Character.PrimaryPart
    if not targetPart then return end

    if me.Action then
        pcall(function()
            me:Action(Enum.ActionType.Inventory, "Use")
        end)
    end

    local network = shared.import and nil
    if network then
        pcall(function()
            network:FireServer("InventoryAction", "Use")
        end)
    end
end

function KillAura:_tick()
    if not self.Enabled then return end
    local now = tick()
    if now - self._last < self.Interval then return end
    self._last = now

    local me = GetMyActor()
    if not me or not me.Position then return end

    local best, bestDist = nil, self.Range
    for _, a in ipairs(GetEnemies()) do
        local pos = a.Position
        if pos then
            local d = (pos - me.Position).Magnitude
            if d < bestDist then bestDist = d; best = a end
        end
    end
    if best then self:_attack(best) end
end

function KillAura:Start()
    if self._running then return end
    self._running = true
    self.Enabled = true
    self._conn = RunService.Heartbeat:Connect(function()
        pcall(function() KillAura:_tick() end)
    end)
    print("[KillAura] STARTED")
end

function KillAura:Stop()
    self._running = false
    self.Enabled = false
    if self._conn then self._conn:Disconnect(); self._conn = nil end
    print("[KillAura] STOPPED")
end

_G.KillAura = KillAura
getgenv().KillAura = KillAura

local AuraKill = {
    Enabled = true,
    Range = 2000,
    Interval = 0.05,
    BatchSize = 3,
    TargetPart = "Head",
    Debug = false,
    _net = nil,
    _remote = nil,
    _lastFire = 0,
    _conn = nil,
    _stats = { sent = 0, failed = 0 },
}

local function AK_log(...)
    if AuraKill.Debug then print("[AuraKill]", ...) end
end

local function AK_FindNet()
    if AuraKill._net and rawget(AuraKill._net, "_code") then return AuraKill._net end
    if shared and type(shared.import) == "function" then
        local ok, net = pcall(function() return shared.import("network") end)
        if ok and type(net) == "table" and rawget(net, "_key") and rawget(net, "_code") then
            AuraKill._net = net
            AK_log("net via shared.import:", tostring(net._code):sub(1,8))
            return net
        end
    end
    local gc
    if filtergc then
        local ok, r = pcall(filtergc, "table")
        if ok and type(r) == "table" then gc = r end
    end
    if not gc then
        local ok, r = pcall(function() return getgc(true) end)
        if ok then gc = r end
    end
    if type(gc) ~= "table" then return nil end
    local uuidPat = "^%x+%-%x+%-%x+%-%x+%-%x+$"
    for _, v in pairs(gc) do
        if type(v) == "table" then
            local k  = rawget(v, "_key")
            local co = rawget(v, "_code")
            local ev = rawget(v, "_events")
            if type(k) == "table" and #k >= 5
               and type(co) == "string" and co:match(uuidPat)
               and type(ev) == "table" then
                local allNum = true
                for _, n in ipairs(k) do
                    if type(n) ~= "number" then allNum = false; break end
                end
                if allNum then
                    AuraKill._net = v
                    AK_log("net via GC:", co:sub(1,8), "key[1]="..tostring(k[1]))
                    return v
                end
            end
        end
    end
    return nil
end

local function AK_GetRemote()
    if AuraKill._remote and AuraKill._remote.Parent then return AuraKill._remote end
    local net = AuraKill._net
    if net then
        local ev = rawget(net, "_events")
        if type(ev) == "table" then
            for name, obj in pairs(ev) do
                if typeof(obj) == "Instance"
                   and (obj:IsA("RemoteEvent") or obj:IsA("RemoteFunction")) then
                    AuraKill._remote = obj
                    AK_log("remote via _events:", name, obj:GetFullName())
                    return obj
                end
            end
        end
    end
    local events = ReplicatedStorage:FindFirstChild("Events")
    if events then
        for _, n in ipairs({"RemoteEvent","Remote","Main","Net"}) do
            local r = events:FindFirstChild(n)
            if r and (r:IsA("RemoteEvent") or r:IsA("RemoteFunction")) then
                AuraKill._remote = r
                return r
            end
        end
    end
    return nil
end

local function AK_NetEncode(jsonStr, key)
    local out = table.create(#jsonStr + (key[5] or 0))
    local n = 0
    for i = 1, #jsonStr do
        local ki   = i % 4
        local kval = key[ki + 1] or 0
        local nb   = (string.byte(jsonStr, i) - 32 + kval) % 95 + 32
        n = n + 1; out[n] = string.char(nb)
    end
    local firstByte = string.byte(jsonStr, 1) or 0
    for v24 = 1, (key[5] or 0) do
        local v27 = firstByte - string.byte(tostring(v24), 1)
        v27 = ((v27 % 256) + 256) % 256
        n = n + 1; out[n] = string.char(v27)
    end
    return table.concat(out)
end

local function AK_Encrypt(data, net)
    local ok, raw = pcall(function() return HttpService:JSONEncode(data) end)
    if not ok or not raw then return nil end
    return AK_NetEncode(raw, net._key)
end

local function AK_GetUID(actor)
    local uuidPat = "^%x+%-%x+%-%x+%-%x+%-%x+$"
    for _, f in ipairs({"UID","_uid","_UID","ActorUID","UUID","_id","Id"}) do
        local v = rawget(actor, f)
        if type(v) == "string" and v:match(uuidPat) then return v end
    end
    for k, v in pairs(actor) do
        if type(v) == "string" and v:match(uuidPat)
           and type(k) == "string" and not k:find("Name") then
            return v
        end
    end
    return nil
end

local function AK_Send(remote, payload)
    if not payload then return false end
    if remote:IsA("RemoteEvent") then
        return pcall(function() remote:FireServer(payload) end)
    elseif remote:IsA("RemoteFunction") then
        return pcall(function() remote:InvokeServer(payload) end)
    end
    return false
end

local function AK_Fire(actor)
    if not actor or not actor.Alive or not actor.Character then return false, "invalid actor" end
    local net = AK_FindNet()
    if not net then return false, "no net" end
    local remote = AK_GetRemote()
    if not remote then return false, "no remote" end
    local char = actor.Character
    local part = char:FindFirstChild(AuraKill.TargetPart)
              or char:FindFirstChild("Head")
              or char:FindFirstChild("UpperTorso")
              or char.PrimaryPart
    if not part then return false, "no part" end
    local pos = part.Position
    local uid = AK_GetUID(actor)
    if not uid then return false, "no uid" end
    local n = math.random(1, 3)

    local slash = AK_Encrypt({net._code, "InventoryAction", "Slash", n}, net)
    if not slash then return false, "encrypt slash" end
    if not AK_Send(remote, slash) then return false, "send slash" end

    task.wait(0.03)

    local impact = AK_Encrypt(
        {net._code, "InventoryAction", "Impact",
         {pos.X, pos.Y, pos.Z}, uid, part.Name},
        net
    )
    if not impact then return false, "encrypt impact" end
    if not AK_Send(remote, impact) then return false, "send impact" end

    AuraKill._stats.sent = AuraKill._stats.sent + 2
    AK_log("fired â†’", actor.OwnerName or uid:sub(1,8), part.Name)
    return true
end

function AuraKill:_tick()
    if not self.Enabled then return end
    local now = tick()
    if now - self._lastFire < self.Interval then return end
    self._lastFire = now

    local me = GetMyActor()
    local myPos = me and me.Position or Camera.CFrame.Position
    local enemies = GetEnemies()
    if #enemies == 0 then return end

    local cand = {}
    for _, a in ipairs(enemies) do
        local p = a.Position or (a.Character and a.Character.PrimaryPart and a.Character.PrimaryPart.Position)
        if p then
            local d = (p - myPos).Magnitude
            if d <= self.Range then
                cand[#cand + 1] = { a = a, d = d }
            end
        end
    end
    if #cand == 0 then return end
    table.sort(cand, function(x, y) return x.d < y.d end)

    local count = math.min(self.BatchSize, #cand)
    for i = 1, count do
        local tgt = cand[i].a
        task.spawn(function()
            local ok, err = AK_Fire(tgt)
            if not ok then
                self._stats.failed = self._stats.failed + 1
                AK_log("fail:", err)
                if err == "no net" then self._net = nil end
                if err == "no remote" then self._remote = nil end
            end
        end)
    end
end

function AuraKill:Start()
    if self._running then return end
    self._running = true
    self.Enabled = true
    task.spawn(AK_FindNet)
    task.spawn(AK_GetRemote)
    self._conn = RunService.Heartbeat:Connect(function()
        pcall(function() AuraKill:_tick() end)
    end)
    print("[AuraKill] STARTED")
end

function AuraKill:Stop()
    self._running = false
    self.Enabled = false
    if self._conn then self._conn:Disconnect(); self._conn = nil end
    print("[AuraKill] STOPPED | sent="..self._stats.sent.." failed="..self._stats.failed)
end

function AuraKill:Rescan()
    self._net = nil; self._remote = nil
    local net = AK_FindNet()
    local re  = AK_GetRemote()
    print("[AuraKill] Rescan: net="..(net and tostring(net._code):sub(1,8) or "nil")
          .." remote="..(re and re:GetFullName() or "nil"))
    return net, re
end

_G.AuraKill = AuraKill
getgenv().AuraKill = AuraKill

local AutoFarm = {
    Enabled = true,
    OffsetY = -2,
    TeleportInterval = 0.15,
    AttackInterval = 0.1,
    _conn = nil,
    _running = false,
    _originCF = nil,
    _lastTP = 0,
    _lastATK = 0,
}

function AutoFarm:_teleportTo(actor)
    local me = GetMyActor()
    if not me then return end
    local pos = actor.Position
    if not pos and actor.Character and actor.Character.PrimaryPart then
        pos = actor.Character.PrimaryPart.Position
    end
    if not pos then return end
    local targetPos = Vector3.new(pos.X, pos.Y + self.OffsetY, pos.Z)
    pcall(function()
        me.SimulatedPosition = targetPos
        me.CFrame = CFrame.new(targetPos)
        if ControllerService and ControllerService.Controller then
            ControllerService.Controller._position = targetPos
            ControllerService.Controller._lastSafePosition = targetPos
        end
    end)
end

function AutoFarm:_getClosest()
    local me = GetMyActor()
    if not me or not me.Position then return nil end
    local best, bestDist = nil, math.huge
    for _, a in ipairs(GetEnemies()) do
        local p = a.Position
        if p then
            local d = (p - me.Position).Magnitude
            if d < bestDist then bestDist = d; best = a end
        end
    end
    return best
end

function AutoFarm:_tick()
    if not self.Enabled then return end
    local target = self:_getClosest()
    if not target then return end

    local now = tick()

    if not self._originCF then
        local me = GetMyActor()
        if me then
            self._originCF = me.CFrame or (me.Position and CFrame.new(me.Position))
        end
    end

    if now - self._lastTP >= self.TeleportInterval then
        self._lastTP = now
        self:_teleportTo(target)
    end

    if now - self._lastATK >= self.AttackInterval then
        self._lastATK = now
        if AuraKill and AuraKill.Enabled then
            task.spawn(function()
                local ok = AK_Fire(target)
                if not ok and AuraKill.Debug then AK_log("autofarm failed") end
            end)
        elseif KillAura and KillAura.Enabled then
            KillAura:_attack(target)
        end
    end
end

function AutoFarm:Start()
    if self._running then return end
    if not (AuraKill.Enabled or KillAura.Enabled) then
        warn("[AutoFarm] Enable AuraKill or KillAura first!")
        return
    end
    self._running = true
    self.Enabled = true
    self._originCF = nil
    self._conn = RunService.Heartbeat:Connect(function()
        pcall(function() AutoFarm:_tick() end)
    end)
    print("[AutoFarm] STARTED")
end

function AutoFarm:Stop()
    self._running = false
    self.Enabled = false
    if self._conn then self._conn:Disconnect(); self._conn = nil end
    if self._originCF then
        local me = GetMyActor()
        if me then
            pcall(function()
                me.SimulatedPosition = self._originCF.Position
                me.CFrame = self._originCF
            end)
        end
    end
    print("[AutoFarm] STOPPED")
end

_G.AutoFarm = AutoFarm
getgenv().AutoFarm = AutoFarm
