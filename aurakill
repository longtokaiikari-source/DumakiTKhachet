-- ──────────────────────────────────────────────────────────────
--  BITSTREAM — Ring Ring: "you need to call bitstream"
--  Executor expose sẵn global `bitstream` hoặc qua rbxraknet
-- ──────────────────────────────────────────────────────────────
local function BS_Get()
    -- Pattern 1: `bitstream` là global object có sẵn Write methods
    -- Ring Ring nói thẳng: call bitstream
    local genv = getgenv()

    -- Direct global `bitstream`
    local raw = rawget(genv, "bitstream")
    if raw then
        -- Có thể là object hoặc constructor
        if type(raw.WriteFloat) == "function" then
            -- Đã là instance
            return raw
        elseif type(raw.new) == "function" then
            local ok, bs = pcall(raw.new, raw)
            if ok and bs and type(bs.WriteFloat) == "function" then return bs end
        elseif type(raw) == "function" then
            local ok, bs = pcall(raw)
            if ok and bs and type(bs.WriteFloat) == "function" then return bs end
        end
    end

    -- Pattern 2: rbxraknet
    for _, name in ipairs({"rbxraknet","RbxRakNet","raknet","RakNet","rbxnet"}) do
        local rn = rawget(genv, name)
        if not rn then continue end
        for _, fn in ipairs({"newBitStream","new","NewBitStream","createBitStream","BitStream"}) do
            if type(rn[fn]) == "function" then
                local ok, bs = pcall(rn[fn], rn)
                if ok and bs and type(bs.WriteFloat) == "function" then
                    return bs
                end
            end
        end
    end

    -- Pattern 3: global constructor functions
    for _, name in ipairs({"newBitStream","NewBitStream","createBitStream","BitStream"}) do
        local fn = rawget(genv, name)
        if type(fn) == "function" then
            local ok, bs = pcall(fn)
            if ok and bs and type(bs.WriteFloat) == "function" then return bs end
        end
    end

    return nil
end

local function BS_Send(bs)
    -- Method 1: bs:Send()
    if type(rawget(bs, "Send")) == "function" then
        pcall(function() bs:Send() end)
        return true
    end
    -- Method 2: rbxraknet.sendPacket(bs)
    local genv = getgenv()
    for _, name in ipairs({"rbxraknet","RbxRakNet","raknet","RakNet"}) do
        local rn = rawget(genv, name)
        if not rn then continue end
        for _, fn in ipairs({"sendPacket","SendPacket","send","Send","firePacket","FirePacket"}) do
            if type(rn[fn]) == "function" then
                pcall(function() rn[fn](rn, bs) end)
                return true
            end
        end
    end
    -- Method 3: global sendPacket
    local sp = rawget(genv, "sendPacket") or rawget(genv, "SendPacket")
    if type(sp) == "function" then
        pcall(function() sp(bs) end)
        return true
    end
    return false
end

-- ──────────────────────────────────────────────────────────────
--  REPLICATOR DATA
-- ──────────────────────────────────────────────────────────────
local _rep = nil
local function GetRep()
    if _rep and _rep.LocalActor then return _rep end
    local gok, gc = pcall(function() return getgc(true) end)
    if gok and gc then
        for _, v in pairs(gc) do
            if type(v)=="table"
            and rawget(v,"LocalActor")
            and rawget(v,"Actors")
            and type(rawget(v,"Actors"))=="table"
            then _rep=v; return v end
        end
    end
    return nil
end

local function GetLocalActor()
    local rep = GetRep()
    return rep and rep.LocalActor
end

-- ──────────────────────────────────────────────────────────────
--  BITSTREAM DESYNC
--  Ring Ring spec:
--    bs:ResetWritePointer()
--    bs:WriteByte(packetID)
--    bs:WriteFloat(X), WriteFloat(Y), WriteFloat(Z)
--    + uid string, orientation, flags
--
--  Roblox UnreliableRemoteEvent raknet packet IDs:
--    0x83 = ReplicationData (most common)
--    0x86 = Physics
--    0x8A = Event
--  Ta thử 0x83 trước — đây là packet type Roblox dùng cho
--  unreliable replication (movement)
-- ──────────────────────────────────────────────────────────────
local _bsDesyncOk = false

local function BS_FakePosition(targetPos)
    local bs = BS_Get()
    if not bs then return false end

    local la  = GetLocalActor()
    local rep = GetRep()
    local uid = ""
    if rep then
        -- _uid per ReplicatorService.lua line 104
        uid = rawget(rep,"_uid") or ""
    end
    if uid == "" and la then
        for _, v in pairs(la) do
            if type(v)=="string" and v:match("^%x+%-%x+%-%x+%-%x+%-%x+$") then
                uid=v; break
            end
        end
    end

    local orientation = la and la.Orientation or 0
    local sprinting   = la and la.Sprinting   or false
    local heightState = la and la.HeightState or 0
    local cameraX     = la and la.CameraX     or 0
    local cameraY     = la and la.CameraY     or 0

    local ok = pcall(function()
        bs:ResetWritePointer()

        -- Packet ID: 0x83 = Roblox unreliable replication
        bs:WriteByte(0x83)

        -- Actor UID (string identifier)
        bs:WriteString(uid)

        -- Position — Ring Ring: WriteFloat for X/Y/Z
        bs:WriteFloat(targetPos.X)
        bs:WriteFloat(targetPos.Y)
        bs:WriteFloat(targetPos.Z)

        -- Orientation (short = 16-bit, degrees * 100)
        bs:WriteShort(math.floor(orientation * 100) % 65536)

        -- Flags (byte): Sprinting bit 0, Grounded bit 1
        local flags = 0
        if sprinting then flags = flags + 1 end
        flags = flags + 2  -- grounded = true
        bs:WriteByte(flags)

        -- HeightState (byte)
        bs:WriteByte(heightState or 0)

        -- Camera angles (short each)
        bs:WriteShort(math.floor(cameraX * 100) % 65536)
        bs:WriteShort(math.floor(cameraY * 100) % 65536)
    end)

    if not ok then return false end

    local sent = BS_Send(bs)
    if sent then _bsDesyncOk = true end
    return sent
end

local function BS_RestorePosition()
    local bs = BS_Get()
    if not bs then return end

    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local realPos = root.Position

    local rep = GetRep()
    local uid = rep and rawget(rep,"_uid") or ""
    local la  = GetLocalActor()
    local orientation = la and la.Orientation or 0

    pcall(function()
        bs:ResetWritePointer()
        bs:WriteByte(0x83)
        bs:WriteString(uid)
        bs:WriteFloat(realPos.X)
        bs:WriteFloat(realPos.Y)
        bs:WriteFloat(realPos.Z)
        bs:WriteShort(math.floor(orientation * 100) % 65536)
        bs:WriteByte(2)  -- grounded, not sprinting
        bs:WriteByte(0)
        bs:WriteShort(0)
        bs:WriteShort(0)
    end)
    BS_Send(bs)

    -- Fallback restore SimulatedPosition
    if la then
        pcall(function()
            la.SimulatedPosition = realPos
            la.ForceNextPosition = nil
        end)
    end
end

-- ──────────────────────────────────────────────────────────────
--  AURAKILL — tipmobile AK_FindNet / AK_Encrypt / AK_Fire
--  copy y chang cipher, thay globals bằng GC
-- ──────────────────────────────────────────────────────────────
local AK = {
    Enabled    = false,
    Range      = 9999,
    Interval   = 0,
    BatchSize  = 10,
    TargetPart = "Head",
    _net       = nil,
    _remote    = nil,
    _lastFire  = 0,
    _conn      = nil,
    _running   = false,
}

local function AK_FindNet()
    if AK._net then return AK._net end
    if shared and type(shared.import)=="function" then
        local ok,net=pcall(function() return shared.import("network") end)
        if ok and net and rawget(net,"_key") and rawget(net,"_code") then
            AK._net=net; print("[AK] net shared.import:", net._code:sub(1,8)); return net
        end
    end
    local gok,gc=pcall(function() return filtergc("table") end)
    if not gok then gok,gc=pcall(function() return getgc(true) end) end
    if gok and gc then
        for _,v in pairs(gc) do
            if type(v)~="table" then continue end
            local k=rawget(v,"_key"); local co=rawget(v,"_code"); local ev=rawget(v,"_events")
            if type(k)~="table" or #k<5 then continue end
            if type(co)~="string" or not co:match("^%x+%-%x+%-%x+%-%x+%-%x+$") then continue end
            if type(ev)~="table" then continue end
            local ok2=true
            for _,n in ipairs(k) do if type(n)~="number" then ok2=false; break end end
            if ok2 then AK._net=v; print("[AK] net GC:", co:sub(1,8)); return v end
        end
    end
    return nil
end

local function AK_GetRemote()
    if AK._remote and AK._remote.Parent then return AK._remote end
    local ev=RS:FindFirstChild("Events")
    if ev then
        local re=ev:FindFirstChild("RemoteEvent")
        if re then AK._remote=re; return re end
    end
    for _,v in ipairs(RS:GetDescendants()) do
        if v:IsA("RemoteEvent") then AK._remote=v; return v end
    end
    return nil
end

-- cipher copy y chang từ tipmobile
local function AK_NetEncode(jsonStr, key)
    local result=""
    for i=1,#jsonStr do
        local ki=i%4
        local kval=key[ki+1]
        local nb=(string.byte(jsonStr,i)-32+kval)%95+32
        result=result..string.char(nb)
    end
    local firstByte=string.byte(jsonStr,1)
    for v24=1,key[5] do
        local v26=tostring(v24)
        local v27=firstByte-string.byte(v26,1)
        result=result..string.char(v27)
    end
    return result
end

local function AK_Encrypt(data, net)
    local ok,raw=pcall(function() return HttpService:JSONEncode(data) end)
    if not ok or not raw then return nil end
    return AK_NetEncode(raw, net._key)
end

local function AK_GetUID(actor)
    for _,field in ipairs({"UID","_id","Id","UUID"}) do
        local v=rawget(actor,field)
        if type(v)=="string" and v:match("^%x+%-%x+%-%x+%-%x+%-%x+$") then return v end
    end
    for _,v in pairs(actor) do
        if type(v)=="string" and v:match("^%x+%-%x+%-%x+%-%x+%-%x+$") then return v end
    end
    return nil
end

local function AK_Fire(actor)
    local net=AK_FindNet(); if not net then return false end
    local remote=AK_GetRemote(); if not remote then return false end
    local char=actor.Character; if not char then return false end
    local part=char:FindFirstChild(AK.TargetPart)
        or char:FindFirstChild("Head")
        or char:FindFirstChild("UpperTorso")
        or char.PrimaryPart
    if not part then return false end
    local pos=part.Position
    local uid=AK_GetUID(actor)
    if not uid then return false end

    -- Step 1: bitstream desync — fake position về target
    BS_FakePosition(pos)

    -- Step 2: Slash — tipmobile cipher
    local n=math.random(1,3)
    local encSlash=AK_Encrypt({net._code,"InventoryAction","Slash",n},net)
    if encSlash then pcall(function() remote:FireServer(encSlash) end) end

    -- Step 3: Impact — tipmobile cipher, ngay sau Slash
    local encImpact=AK_Encrypt(
        {net._code,"InventoryAction","Impact",{pos.X,pos.Y,pos.Z},uid,part.Name},
        net
    )
    if encImpact then pcall(function() remote:FireServer(encImpact) end) end

    -- Step 4: Restore
    task.delay(0.15, BS_RestorePosition)
    return true
end

local function GetActors()
    local rep=GetRep()
    if rep and rep.Actors then return rep.Actors end
    local r={}
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=LocalPlayer and p.Character then
            r[#r+1]={Alive=true,Character=p.Character,UID=tostring(p.UserId)}
        end
    end
    return r
end

local function AK_Tick()
    if not AK.Enabled then return end
    local now=tick()
    if now-AK._lastFire<AK.Interval then return end
    local myChar=LocalPlayer.Character
    local root=myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local myPos=root.Position
    local actors=GetActors()
    local candidates={}
    for _,a in pairs(actors) do
        if not a or not a.Alive or not a.Character then continue end
        local pp=a.Character.PrimaryPart
        if not pp then continue end
        local d=(pp.Position-myPos).Magnitude
        if d<=AK.Range then candidates[#candidates+1]={Actor=a,Distance=d} end
    end
    if #candidates==0 then return end
    table.sort(candidates,function(a,b) return a.Distance<b.Distance end)
    AK._lastFire=now
    local count=math.min(AK.BatchSize,#candidates)
    for i=1,count do
        local t=candidates[i].Actor
        task.spawn(function()
            if not AK_Fire(t) then AK._net=nil end
        end)
    end
end

function AK.Start()
    if AK._running then return end
    AK._running=true
    task.spawn(AK_FindNet); task.spawn(AK_GetRemote)
    AK._conn=RunService.Heartbeat:Connect(AK_Tick)
    print("[AK] Started — bitstream desync + tipmobile cipher")
end

function AK.Stop()
    AK._running=false
    if AK._conn then pcall(function() AK._conn:Disconnect() end); AK._conn=nil end
    BS_RestorePosition()
    print("[AK] Stopped")
end

