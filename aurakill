-- ============================================================
--  AURAKILL — dump-verified MeleeInventory + MeleeInventoryReplicator
--
--  Packet layout đúng per source:
--    Slash:  net:FireServer("InventoryAction", "Slash", n)       -- n=1-3
--    Impact: net:FireServer("InventoryAction", "Impact", dir, uid, partName)
--               dir = {dirX, dirY, dirZ}  -- direction vector, NOT position
--               server raycast từ actor.CFrame chest theo dir này
--
--  Raknet desync: fake SimulatedPosition về phía target trước khi gửi Impact
--  → server raycast từ vị trí giả → hit dù đứng xa
--
--  Một nút bật/tắt. Drag được.
-- ============================================================

local RunService  = game:GetService("RunService")
local Players     = game:GetService("Players")
local LocalPlayer = Players.LocalPlayer

-- Default reach = 5-7 studs per Melee.lua config
-- Dùng 7 (Tomahawk/Hooligan max reach) để chắc ăn
local REACH = 7

local AK = {
    Enabled    = false,
    _net       = nil,
    _localActor= nil,
    _lastFire  = 0,
    _conn      = nil,
}

-- ──────────────────────────────────────────────────────────────
--  GET NETWORK OBJECT — shared.import("network") per Flux_client.lua
-- ──────────────────────────────────────────────────────────────
local function GetNet()
    if AK._net then return AK._net end
    if shared and type(shared.import) == "function" then
        local ok, net = pcall(function() return shared.import("network") end)
        if ok and net and type(net.FireServer) == "function" then
            AK._net = net; return net
        end
    end
    local gok, gc = pcall(function() return filtergc("table") end)
    if not gok then gok, gc = pcall(function() return getgc(true) end) end
    if gok and gc then
        for _, v in pairs(gc) do
            if type(v) ~= "table" then continue end
            if type(rawget(v,"FireServer")) == "function"
                and type(rawget(v,"_key")) == "table"
                and type(rawget(v,"_code")) == "string"
            then
                AK._net = v; return v
            end
        end
    end
    return nil
end

-- ──────────────────────────────────────────────────────────────
--  GET LOCAL ACTOR — Replicator.LocalActor
-- ──────────────────────────────────────────────────────────────
local function GetLocalActor()
    if AK._localActor then return AK._localActor end
    local gok, gc = pcall(function() return getgc(true) end)
    if gok and gc then
        for _, v in pairs(gc) do
            if type(v)=="table"
                and rawget(v,"LocalActor")
                and rawget(v,"Actors")
            then
                AK._localActor = v.LocalActor
                return AK._localActor
            end
        end
    end
    return nil
end

-- ──────────────────────────────────────────────────────────────
--  GET ACTORS TABLE
-- ──────────────────────────────────────────────────────────────
local function GetActors()
    local gok, gc = pcall(function() return getgc(true) end)
    if gok and gc then
        for _, v in pairs(gc) do
            if type(v)=="table"
                and rawget(v,"LocalActor")
                and rawget(v,"Actors")
                and type(rawget(v,"Actors"))=="table"
            then
                return v.Actors
            end
        end
    end
    local result = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            result[#result+1] = {
                Alive=true, Character=p.Character,
                UID=tostring(p.UserId),
            }
        end
    end
    return result
end

-- ──────────────────────────────────────────────────────────────
--  GET UID
-- ──────────────────────────────────────────────────────────────
local function GetUID(actor)
    for _, field in ipairs({"UID","_id","Id","UUID"}) do
        local v = rawget(actor, field)
        if type(v)=="string" and v:match("^%x+%-%x+%-%x+%-%x+%-%x+$") then return v end
    end
    for _, v in pairs(actor) do
        if type(v)=="string" and v:match("^%x+%-%x+%-%x+%-%x+%-%x+$") then return v end
    end
    return nil
end

-- ──────────────────────────────────────────────────────────────
--  FAKE SIMULATED POSITION — raknet desync
--  Set SimulatedPosition về phía target → server raycast từ đó
-- ──────────────────────────────────────────────────────────────
local function FakePos(targetPos)
    local la = GetLocalActor()
    if la then
        pcall(function() la.SimulatedPosition = targetPos end)
    end
    -- Fallback: character HumanoidRootPart CFrame
    local char = LocalPlayer.Character
    if char then
        local root = char:FindFirstChild("HumanoidRootPart")
        if root then
            pcall(function()
                root.CFrame = CFrame.new(targetPos)
            end)
        end
    end
end

local function RestorePos(originalPos)
    local la = GetLocalActor()
    if la then
        pcall(function() la.SimulatedPosition = originalPos end)
    end
end

-- ──────────────────────────────────────────────────────────────
--  FIRE — packet đúng per MeleeInventory._use + MeleeInventoryReplicator.Impact
--
--  Server flow:
--    1. Nhận "Slash" → play animation
--    2. Nhận "Impact" với direction vector dir
--    3. Server raycast từ actor.CFrame:PointToWorldSpace(0,2.5,0) theo dir
--    4. Nếu hit → apply damage
--
--  Desync flow:
--    1. Fake SimulatedPosition về sát target
--    2. Gửi Slash
--    3. task.delay(0.3) gửi Impact với dir = (target - fakePos).Unit * REACH
--    4. Restore SimulatedPosition
-- ──────────────────────────────────────────────────────────────
local function AK_Fire(actor)
    local net = GetNet()
    if not net then return false end

    local char = actor.Character
    if not char then return false end

    -- Tìm target part
    local part = char:FindFirstChild("Head")
               or char:FindFirstChild("UpperTorso")
               or char.PrimaryPart
    if not part then return false end

    local uid = GetUID(actor)
    if not uid then return false end

    local targetPos = part.Position

    -- Lưu vị trí thật
    local la = GetLocalActor()
    local realPos = la and la.SimulatedPosition
    local char2 = LocalPlayer.Character
    local root = char2 and char2:FindFirstChild("HumanoidRootPart")
    local realCF = root and root.CFrame

    -- Fake position về sát target (0.5 studs trước mặt target)
    local fakePos = targetPos + Vector3.new(0, 0, 0.5)
    FakePos(fakePos)

    local n = math.random(1, 3)

    -- Slash packet — exact per MeleeInventory line: v_u_2:FireServer("InventoryAction","Slash",v13)
    pcall(function()
        net:FireServer("InventoryAction", "Slash", n)
    end)

    -- Impact packet sau delay (per _use: task.delay(p_u_11._delay, ...))
    -- dir = camera.CFrame.LookVector * _distance trong source
    -- Nhưng ta fake pos rồi nên dir = (target - fakePos).Unit * REACH
    task.delay(0.25, function()
        pcall(function()
            local dir = (targetPos - fakePos).Unit * REACH
            -- vector3toTable = {X,Y,Z} per source
            net:FireServer("InventoryAction", "Impact", {dir.X, dir.Y, dir.Z}, uid, part.Name)
        end)
        -- Restore position sau khi Impact gửi xong
        task.delay(0.05, function()
            if realPos then RestorePos(realPos) end
            if realCF and root then
                pcall(function() root.CFrame = realCF end)
            end
        end)
    end)

    return true
end

-- ──────────────────────────────────────────────────────────────
--  TICK
-- ──────────────────────────────────────────────────────────────
local function AK_Tick()
    if not AK.Enabled then return end
    local now = tick()
    -- Rate limit: 1 swing per 0.5s để không spam server
    if now - AK._lastFire < 0.5 then return end

    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local myPos = root.Position

    local actors = GetActors()
    local closest = nil
    local closestDist = math.huge

    for _, a in pairs(actors) do
        if not a or not a.Alive or not a.Character then continue end
        local aPos
        local pp = a.Character.PrimaryPart
        if pp then aPos = pp.Position end
        if not aPos then continue end
        local d = (aPos - myPos).Magnitude
        if d < closestDist then
            closestDist = d
            closest = a
        end
    end

    if not closest then return end

    AK._lastFire = now
    task.spawn(function()
        if not AK_Fire(closest) then
            AK._net = nil
            AK._localActor = nil
        end
    end)
end

