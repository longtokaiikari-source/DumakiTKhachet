-- ============================================================
--  AURAKILL — tipmobile pattern, extended range via SimulatedPosition
--
--  tipmobile logic (verified):
--    1. Fake myActor.SimulatedPosition + ctrl._position = targetPos
--    2. Fire Slash + Impact với target part position
--    3. Server raycast từ actor "đã ở" cạnh target → hit → damage
--
--  Packet format per Flux_client dump:
--    Slash:  encrypt({_code, "InventoryAction", "Slash", n})  → RemoteEvent:FireServer
--    Impact: encrypt({_code, "InventoryAction", "Impact", {x,y,z}, uid, part}) → FireServer
-- ============================================================

local RunService  = game:GetService("RunService")
local Players     = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer

local AK = {
    Enabled    = false,
    Range      = 9999,   -- unlimited — SimulatedPosition fake nên range không giới hạn
    Interval   = 0,
    BatchSize  = 10,
    TargetPart = "Head",
    _net       = nil,
    _remote    = nil,
    _rep       = nil,
    _ctrl      = nil,    -- ControllerService.Controller
    _lastFire  = 0,
    _conn      = nil,
    _running   = false,
}

-- ──────────────────────────────────────────────────────────────
--  NETWORK — Flux_client.lua pattern
-- ──────────────────────────────────────────────────────────────
local function AK_FindNet()
    if AK._net then return AK._net end
    if shared and type(shared.import)=="function" then
        local ok,net=pcall(function() return shared.import("network") end)
        if ok and net and type(rawget(net,"_key"))=="table"
            and type(rawget(net,"_code"))=="string" then
            AK._net=net; return net
        end
    end
    local gok,gc=pcall(function() return filtergc("table") end)
    if not gok then gok,gc=pcall(function() return getgc(true) end) end
    if gok and gc then
        for _,v in pairs(gc) do
            if type(v)~="table" then continue end
            local k=rawget(v,"_key"); local co=rawget(v,"_code"); local ev=rawget(v,"_events")
            if type(k)~="table" or #k<5 then continue end
            if type(co)~="string" or not co:match("^%x+%-%x+%-%x+%-%x+%-%x+$") then continue end
            local ok2=true
            for _,n in ipairs(k) do if type(n)~="number" then ok2=false; break end end
            if ok2 then AK._net=v; return v end
        end
    end
    return nil
end

local function AK_GetRemote()
    if AK._remote and AK._remote.Parent then return AK._remote end
    local RS=game:GetService("ReplicatedStorage")
    local ev=RS:FindFirstChild("Events")
    if ev then
        local re=ev:FindFirstChild("RemoteEvent")
        if re then AK._remote=re; return re end
    end
    for _,v in ipairs(RS:GetDescendants()) do
        if v:IsA("RemoteEvent") then AK._remote=v; return v end
    end
    return nil
end

-- ──────────────────────────────────────────────────────────────
--  CIPHER — Flux_client.lua netEncode (verified per tipmobile)
-- ──────────────────────────────────────────────────────────────
local function AK_NetEncode(jsonStr, key)
    local result=""
    for i=1,#jsonStr do
        local ki=i%4
        local kval=key[ki+1]
        local nb=(string.byte(jsonStr,i)-32+kval)%95+32
        result=result..string.char(nb)
    end
    local firstByte=string.byte(jsonStr,1)
    for v24=1,key[5] do
        local v26=tostring(v24)
        local v27=firstByte-string.byte(v26,1)
        result=result..string.char(v27)
    end
    return result
end

local function AK_Encrypt(data, net)
    local ok,raw=pcall(function() return HttpService:JSONEncode(data) end)
    if not ok or not raw then return nil end
    return AK_NetEncode(raw, net._key)
end

-- ──────────────────────────────────────────────────────────────
--  GET LOCAL ACTOR + CONTROLLER
-- ──────────────────────────────────────────────────────────────
local function GetLocalActor()
    if AK._rep and AK._rep.LocalActor then return AK._rep.LocalActor end
    local gok,gc=pcall(function() return getgc(true) end)
    if gok and gc then
        for _,v in pairs(gc) do
            if type(v)=="table"
            and rawget(v,"LocalActor")
            and rawget(v,"Actors")
            then
                AK._rep=v; return v.LocalActor
            end
        end
    end
    return nil
end

local function GetController()
    if AK._ctrl then return AK._ctrl end
    local gok,gc=pcall(function() return getgc(true) end)
    if gok and gc then
        for _,v in pairs(gc) do
            if type(v)=="table"
            and rawget(v,"_position") ~= nil
            and rawget(v,"_lastSafePosition") ~= nil
            and (rawget(v,"MoveSpeed") or rawget(v,"_accelerate") or rawget(v,"_integrate"))
            then
                AK._ctrl=v; return v
            end
        end
    end
    return nil
end

-- ──────────────────────────────────────────────────────────────
--  FAKE POSITION — tipmobile AutoFarm pattern (dòng 3085-3099)
--  Set SimulatedPosition + ctrl._position về targetPos
--  → server nghĩ actor đứng cạnh target → raycast hit
-- ──────────────────────────────────────────────────────────────
local _realPos = nil
local function FakePosition(targetPos)
    local myActor = GetLocalActor()
    if not myActor then return end
    _realPos = myActor.SimulatedPosition or myActor.Position
    pcall(function()
        local ctrl = GetController()
        if ctrl then
            ctrl._position = targetPos
            ctrl._lastSafePosition = targetPos
        end
        myActor.SimulatedPosition = targetPos
        myActor.CFrame = CFrame.new(targetPos)
    end)
end

local function RestorePosition()
    if not _realPos then return end
    local myActor = GetLocalActor()
    if not myActor then return end
    pcall(function()
        local char = LocalPlayer.Character
        local root = char and char:FindFirstChild("HumanoidRootPart")
        local realPos = (root and root.Position) or _realPos
        local ctrl = GetController()
        if ctrl then
            ctrl._position = realPos
            ctrl._lastSafePosition = realPos
        end
        myActor.SimulatedPosition = realPos
    end)
    _realPos = nil
end

-- ──────────────────────────────────────────────────────────────
--  GET UID
-- ──────────────────────────────────────────────────────────────
local function AK_GetUID(actor)
    for _,field in ipairs({"UID","_id","Id","UUID"}) do
        local v=rawget(actor,field)
        if type(v)=="string" and v:match("^%x+%-%x+%-%x+%-%x+%-%x+$") then return v end
    end
    for _,v in pairs(actor) do
        if type(v)=="string" and v:match("^%x+%-%x+%-%x+%-%x+%-%x+$") then return v end
    end
    return nil
end

-- ──────────────────────────────────────────────────────────────
--  FIRE — tipmobile AK_Fire + SimulatedPosition fake
-- ──────────────────────────────────────────────────────────────
local function AK_Fire(actor)
    local net    = AK_FindNet();    if not net    then return false end
    local remote = AK_GetRemote(); if not remote then return false end
    local char   = actor.Character; if not char   then return false end

    local part = char:FindFirstChild(AK.TargetPart)
               or char:FindFirstChild("Head")
               or char:FindFirstChild("UpperTorso")
               or char.PrimaryPart
    if not part then return false end

    local uid = AK_GetUID(actor)
    if not uid then return false end

    local targetPos = part.Position

    -- Step 1: Fake SimulatedPosition về sát target
    -- tipmobile dùng Y + OffsetY nhưng ta dùng Y thẳng
    FakePosition(targetPos)

    -- Step 2: Slash packet — {_code, "InventoryAction", "Slash", n}
    local n = math.random(1,3)
    local encSlash = AK_Encrypt({net._code, "InventoryAction", "Slash", n}, net)
    if encSlash then pcall(function() remote:FireServer(encSlash) end) end

    -- Step 3: Impact ngay sau Slash (tipmobile không delay)
    local encImpact = AK_Encrypt(
        {net._code, "InventoryAction", "Impact", {targetPos.X, targetPos.Y, targetPos.Z}, uid, part.Name},
        net
    )
    if encImpact then pcall(function() remote:FireServer(encImpact) end) end

    -- Step 4: Restore position sau 100ms
    task.delay(0.1, RestorePosition)

    return true
end

-- ──────────────────────────────────────────────────────────────
--  GET ACTORS
-- ──────────────────────────────────────────────────────────────
local function GetActors()
    if AK._rep and AK._rep.Actors then return AK._rep.Actors end
    local gok,gc=pcall(function() return getgc(true) end)
    if gok and gc then
        for _,v in pairs(gc) do
            if type(v)=="table"
            and rawget(v,"LocalActor")
            and rawget(v,"Actors")
            and type(rawget(v,"Actors"))=="table"
            then AK._rep=v; return v.Actors end
        end
    end
    local result={}
    for _,p in ipairs(Players:GetPlayers()) do
        if p~=LocalPlayer and p.Character then
            result[#result+1]={Alive=true,Character=p.Character,UID=tostring(p.UserId)}
        end
    end
    return result
end

-- ──────────────────────────────────────────────────────────────
--  TICK
-- ──────────────────────────────────────────────────────────────
local function AK_Tick()
    if not AK.Enabled then return end
    local now=tick()
    if now-AK._lastFire<AK.Interval then return end

    local myChar=LocalPlayer.Character
    local root=myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local myPos=root.Position

    local actors=GetActors()
    local candidates={}

    for _,a in pairs(actors) do
        if not a or not a.Alive or not a.Character then continue end
        local pp=a.Character.PrimaryPart
        if not pp then continue end
        local d=(pp.Position-myPos).Magnitude
        if d<=AK.Range then
            candidates[#candidates+1]={Actor=a,Distance=d}
        end
    end

    if #candidates==0 then return end
    table.sort(candidates,function(a,b) return a.Distance<b.Distance end)

    AK._lastFire=now
    local count=math.min(AK.BatchSize,#candidates)
    for i=1,count do
        local target=candidates[i].Actor
        task.spawn(function()
            if not AK_Fire(target) then AK._net=nil; AK._remote=nil end
        end)
    end
end

