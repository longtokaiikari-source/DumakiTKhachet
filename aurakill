-- ============================================================
--  AURAKILL — tipmobile cipher + bitstream desync
--  Ring Ring spec: "you need to call bitstream"
--
--  Desync flow:
--    bs = bitstream (executor global)
--    bs:ResetWritePointer()
--    bs:WriteByte(packetID)
--    bs:WriteFloat(X) bs:WriteFloat(Y) bs:WriteFloat(Z)
--    bs:Send() / rbxraknet.sendPacket(bs)
--
--  Sau đó fire Slash + Impact qua encrypted RemoteEvent
--  như tipmobile — cipher đã verified
-- ============================================================

local RunService  = game:GetService("RunService")
