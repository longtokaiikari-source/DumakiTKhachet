btn.Font = Enum.Font.GothamBold
btn.TextSize = 14
btn.Parent = frame
Instance.new("UICorner", btn).CornerRadius = UDim.new(0,6)

btn.MouseButton1Click:Connect(function()
    AK.Enabled = not AK.Enabled
    if AK.Enabled then
        task.spawn(GetNet)
        task.spawn(GetLocalActor)
        if not AK._conn then
            AK._conn = RunService.Heartbeat:Connect(AK_Tick)
        end
        btn.BackgroundColor3 = Color3.fromRGB(200,45,45)
        btn.Text = "DISABLE"
    else
        if AK._conn then
            pcall(function() AK._conn:Disconnect() end)
            AK._conn = nil
        end
        btn.BackgroundColor3 = Color3.fromRGB(45,160,75)
        btn.Text = "ENABLE"
    end
end)

RunService.Heartbeat:Connect(function()
    local netOk = AK._net ~= nil
    local laOk  = AK._localActor ~= nil
    statusLabel.Text = string.format("Net: %s | Actor: %s | %s",
        netOk and "OK" or "...",
        laOk  and "OK" or "...",
        AK.Enabled and "ON" or "OFF"
    )
end)

