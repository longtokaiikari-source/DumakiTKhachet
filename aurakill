-- ============================================================
--  AURAKILL — rbxraknet bitstream desync
--  Ring Ring spec: fake ReplicateMovement packet via raknet
--  để server nghĩ mày đứng cạnh NPC trong khi đứng xa
--
--  rbxraknet API (Synapse X / UNC standard):
--    local bs = rbxraknet.newBitStream()
--    bs:ResetWritePointer()
--    bs:WriteByte(packetID)
--    bs:WriteString(...)
--    bs:WriteFloat(x) bs:WriteFloat(y) bs:WriteFloat(z)
--    rbxraknet.sendPacket(bs)  /  bs:Send()
--
--  ReplicatorService.lua line 230 — packet format:
--    FireUnreliableServer("ReplicateMovement", uid,
--        pos.X, pos.Y, pos.Z,
--        Orientation, Sprinting, HeightState,
--        CameraX, CameraY, LeanGoal, Platform)
--
--  Fallback: ForceNextPosition (dump-verified line 229)
-- ============================================================

local RunService  = game:GetService("RunService")
local Players     = game:GetService("Players")
local HttpService = game:GetService("HttpService")
local LocalPlayer = Players.LocalPlayer

local REACH = 7  -- max per Melee.lua (Tomahawk)

local AK = {
    Enabled     = false,
    _net        = nil,
    _replicator = nil,
    _uid        = nil,
    _lastFire   = 0,
    _conn       = nil,
}

-- ──────────────────────────────────────────────────────────────
--  RAKNET API PROBE — tìm đúng tên executor expose
-- ──────────────────────────────────────────────────────────────
local RakNet = nil
local function GetRakNet()
    if RakNet then return RakNet end
    -- Synapse X / KRNL / Fluxus / UNC standard names
    for _, name in ipairs({
        "rbxraknet","RbxRakNet","raknet","RakNet",
        "NetworkClient","rbxnetwork","RbxNetwork",
    }) do
        local v = rawget(getgenv(), name)
        if v then RakNet = v; print("[AK] raknet API:", name); return v end
    end
    return nil
end

-- newBitStream — tên khác nhau tùy executor
local function NewBS()
    local rn = GetRakNet()
    if not rn then return nil end
    for _, fn in ipairs({"newBitStream","new","NewBitStream","createBitStream","BitStream"}) do
        if type(rn[fn]) == "function" then
            local ok, bs = pcall(rn[fn], rn)
            if ok and bs then return bs end
        end
    end
    -- Một số executor expose thẳng hàm global
    for _, fn in ipairs({"newBitStream","NewBitStream","rbxraknet_new"}) do
        local gv = rawget(getgenv(), fn)
        if type(gv) == "function" then
            local ok, bs = pcall(gv)
            if ok and bs then return bs end
        end
    end
    return nil
end

-- Send bitstream — tên khác nhau tùy executor
local function SendBS(bs)
    -- Method 1: bs:Send()
    if type(rawget(bs,"Send")) == "function" then
        pcall(function() bs:Send() end); return
    end
    -- Method 2: rbxraknet.sendPacket(bs)
    local rn = GetRakNet()
    if rn then
        for _, fn in ipairs({"sendPacket","SendPacket","send","Send","firePacket"}) do
            if type(rn[fn]) == "function" then
                pcall(function() rn[fn](rn, bs) end); return
            end
        end
    end
end

-- ──────────────────────────────────────────────────────────────
--  GET NETWORK OBJECT
-- ──────────────────────────────────────────────────────────────
local function GetNet()
    if AK._net then return AK._net end
    local gok, gc = pcall(function() return filtergc("table") end)
    if not gok then gok, gc = pcall(function() return getgc(true) end) end
    if gok and gc then
        for _, v in pairs(gc) do
            if type(v) ~= "table" then continue end
            if type(rawget(v,"FireServer")) == "function"
            and type(rawget(v,"_key"))     == "table"
            and type(rawget(v,"_code"))    == "string"
            then
                AK._net = v; return v
            end
        end
    end
    return nil
end

-- ──────────────────────────────────────────────────────────────
--  GET REPLICATOR + UID
--  ReplicatorService: v107=p105._uid, v108=p105.LocalActor
-- ──────────────────────────────────────────────────────────────
local function GetReplicator()
    if AK._replicator and AK._replicator.LocalActor then
        return AK._replicator
    end
    local gok, gc = pcall(function() return getgc(true) end)
    if gok and gc then
        for _, v in pairs(gc) do
            if type(v) == "table"
            and rawget(v,"LocalActor")
            and rawget(v,"Actors")
            and rawget(v,"_uid")
            then
                AK._replicator = v
                AK._uid = v._uid
                return v
            end
        end
        -- fallback: không có _uid trực tiếp
        for _, v in pairs(gc) do
            if type(v) == "table"
            and rawget(v,"LocalActor")
            and rawget(v,"Actors")
            then
                AK._replicator = v
                return v
            end
        end
    end
    return nil
end

-- ──────────────────────────────────────────────────────────────
--  GET UID
-- ──────────────────────────────────────────────────────────────
local function GetUID(actor)
    for _, field in ipairs({"UID","_id","Id","UUID"}) do
        local v = rawget(actor, field)
        if type(v)=="string" and v:match("^%x+%-%x+%-%x+%-%x+%-%x+$") then return v end
    end
    for _, v in pairs(actor) do
        if type(v)=="string" and v:match("^%x+%-%x+%-%x+%-%x+%-%x+$") then return v end
    end
    return nil
end

-- ──────────────────────────────────────────────────────────────
--  FAKE REPLICATEMOVEMENT — raknet bitstream path
--  ReplicatorService line 230:
--    FireUnreliableServer("ReplicateMovement", uid,
--        X, Y, Z, Orientation, Sprinting, HeightState,
--        CameraX, CameraY, LeanGoal, Platform)
--  FireUnreliableServer = UnreliableRemoteEvent:FireServer(JSONEncode({...}))
--  Ở đây ta inject vào raknet layer thấp hơn để spoof position
-- ──────────────────────────────────────────────────────────────
local function FakeReplicateMovement(fakePos)
    local rep = GetReplicator()
    local la  = rep and rep.LocalActor
    if not la then return false end

    -- Method 1: rbxraknet bitstream — gửi thẳng packet
    local bs = NewBS()
    if bs then
        -- UnreliableRemoteEvent packet structure (Roblox internal):
        -- packet ID 0x83 (131) = ReplicationData
        -- sau đó là JSON payload giống FireUnreliableServer
        local uid  = AK._uid or rep._uid or ""
        local ori  = la.Orientation or 0
        local spr  = la.Sprinting   or false
        local hs   = la.HeightState or 0
        local cx   = la.CameraX     or 0
        local cy   = la.CameraY     or 0
        local lean = la.LeanGoal    or 0
        local plat = la.Platform    or false

        local payload = HttpService:JSONEncode({
            "ReplicateMovement", uid,
            fakePos.X, fakePos.Y, fakePos.Z,
            ori, spr, hs, cx, cy, lean, plat
        })

        pcall(function()
            bs:ResetWritePointer()
            bs:WriteByte(0x83)        -- Roblox replication packet ID
            bs:WriteString(payload)
            SendBS(bs)
        end)
        return true
    end

    -- Method 2: ForceNextPosition fallback (dump-verified)
    pcall(function() la.ForceNextPosition = fakePos end)
    pcall(function() la.SimulatedPosition = fakePos end)
    return true
end

-- ──────────────────────────────────────────────────────────────
--  FIRE
-- ──────────────────────────────────────────────────────────────
local function AK_Fire(actor)
    local net = GetNet()
    if not net then return false end

    local char = actor.Character
    if not char then return false end

    local part = char:FindFirstChild("Head")
               or char:FindFirstChild("UpperTorso")
               or char.PrimaryPart
    if not part then return false end

    local uid = GetUID(actor)
    if not uid then return false end

    local targetPos = part.Position
    local fakePos   = targetPos + Vector3.new(0, 0.5, 0)

    -- Step 1: fake position lên server
    FakeReplicateMovement(fakePos)

    -- Step 2: Slash
    local n = math.random(1, 3)
    pcall(function()
        net:FireServer("InventoryAction", "Slash", n)
    end)

    -- Step 3: Impact sau delay
    task.delay(0.25, function()
        pcall(function()
            local dir = (targetPos - fakePos)
            dir = (dir.Magnitude > 0 and dir.Unit or Vector3.new(0,0,-1)) * REACH
            net:FireServer("InventoryAction", "Impact",
                {dir.X, dir.Y, dir.Z}, uid, part.Name)
        end)

        -- Step 4: restore
        task.delay(0.05, function()
            local myChar = LocalPlayer.Character
            local root   = myChar and myChar:FindFirstChild("HumanoidRootPart")
            local rep2   = GetReplicator()
            local la2    = rep2 and rep2.LocalActor
            if la2 and root then
                pcall(function()
                    la2.SimulatedPosition  = root.Position
                    la2.ForceNextPosition  = nil
                end)
            end
        end)
    end)

    return true
end

-- ──────────────────────────────────────────────────────────────
--  GET ACTORS
-- ──────────────────────────────────────────────────────────────
local function GetActors()
    local rep = GetReplicator()
    if rep and rep.Actors then return rep.Actors end
    local result = {}
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            result[#result+1] = {
                Alive=true, Character=p.Character,
                UID=tostring(p.UserId),
            }
        end
    end
    return result
end

-- ──────────────────────────────────────────────────────────────
--  TICK
-- ──────────────────────────────────────────────────────────────
local function AK_Tick()
    if not AK.Enabled then return end
    local now = tick()
    if now - AK._lastFire < 0.5 then return end

    local myChar = LocalPlayer.Character
    local root   = myChar and myChar:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local myPos  = root.Position

    local actors   = GetActors()
    local closest  = nil
    local closestD = math.huge

    for _, a in pairs(actors) do
        if not a or not a.Alive or not a.Character then continue end
        local pp = a.Character.PrimaryPart
        if not pp then continue end
        local d = (pp.Position - myPos).Magnitude
        if d < closestD then closestD = d; closest = a end
    end

    if not closest then return end
    AK._lastFire = now
    task.spawn(function()
        if not AK_Fire(closest) then
            AK._net = nil; AK._replicator = nil
        end
    end)
end

